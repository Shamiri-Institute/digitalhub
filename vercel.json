{
  "buildCommand": "pnpm run build:deploy",
  "crons": [
    { "path": "/api/cron/survey-print-files", "schedule": "* * * * *" },
    { "path": "/api/cron/survey-pipeline-notify", "schedule": "* * * * *" },
    { "path": "/api/cron/close-tickets", "schedule": "0 * * * *" }
  ],
  "schedules": {
    "transcriptions": {
      "schedule": "* * * * *",
      "path": "/api/cron/transcriptions",
      "requestMethod": "GET"
    }
  }
}
