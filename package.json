{
  "name": "digitalhub-frontend",
  "version": "2.15.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.x"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:deploy": "if [ -n \"$PREVIEW_DATABASE_URL\" ]; then tsx scripts/db/reset.ts && drizzle-kit migrate && tsx db/seed/seed.ts; else drizzle-kit migrate; fi && next build",
    "start": "next start",
    "format": "oxfmt",
    "stylecheck": "oxfmt --check && oxlint --type-aware",
    "typecheck": "next typegen && node node_modules/typescript7/bin/tsc --noEmit",
    "test:ci": "playwright test",
    "test": "dotenv -c development -- playwright test",
    "test:ui": "dotenv -c development -- playwright test --ui",
    "test:prod": "dotenv -c development -v NEXT_PUBLIC_ENV=testing -v E2E_PROD=1 -- sh -c 'next build && playwright test'",
    "test:unit": "dotenv -c development -- vitest",
    "auth:session": "dotenv -c development -- tsx scripts/auth/get-session-cookie.ts",
    "db:seed": "dotenv -c development -- tsx db/seed/seed.ts",
    "db:migrate": "dotenv -c development -- drizzle-kit migrate",
    "db:reset": "dotenv -c development -- sh -c \"tsx scripts/db/reset.ts && drizzle-kit migrate && tsx db/seed/seed.ts\"",
    "db:generate": "dotenv -c development -- drizzle-kit generate",
    "release": "commit-and-tag-version",
    "db:check": "dotenv -c development -- tsx scripts/db/check-schema.ts",
    "survey:metrics": "tsx scripts/survey/generate-figtree-metrics.ts && oxfmt lib/survey/figtree-metrics.generated.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "commit-and-tag-version": {
    "scripts": {
      "precommit": "pnpm run format > /dev/null"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.987.0",
    "@aws-sdk/s3-request-presigner": "^3.987.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@google/genai": "^2.32.0",
    "@hookform/resolvers": "^5.2.2",
    "@internationalized/date": "^3.10.1",
    "@noble/hashes": "^2.4.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-accordion": "^1.2.1",
