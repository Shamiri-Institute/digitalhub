{
  "name": "digitalhub-frontend",
  "version": "1.34.1",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel:build": "if [ -n \"$VERCEL_ENV\" ] && [ \"$VERCEL_ENV\" != \"production\" ]; then npm run vercel:seeded:build; else npm run vercel:prod:build; fi",
    "vercel:prod:build": "prisma generate && prisma migrate deploy && next build",
    "vercel:seeded:build": "prisma generate && prisma migrate reset --force && prisma migrate deploy && npm run db:seed && next build",
    "start": "next start",
    "format": "biome format --write",
    "stylecheck": "biome check",
    "biome:ci": "biome ci",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:ci": "playwright test",
    "test:dev": "dotenv -c development -- playwright test",
    "test:dev:only": "dotenv -c development -- playwright test --ui tests/e2e/hub-coordinator/schools-view.spec.ts",
    "test:dev:ui": "dotenv -c development -- playwright test --ui",
    "test:unit": "dotenv -c development -- vitest",
    "next-auth:session": "dotenv -c development -- tsx scripts/auth/get-next-session.ts",
    "db:dev:up": "docker-compose down && docker-compose up db",
    "db:seed": "dotenv -c development -- tsx prisma/scripts/seed.ts",
    "db:dev:migrate": "dotenv -c development -- npx prisma migrate dev",
    "db:dev:migrate:reset": "dotenv -c development -- npx prisma migrate reset --force",
    "db:dev:generate": "dotenv -c development -- npx prisma generate",
    "db:dump:local": "dotenv -c development -- ./scripts/db/dump-db.sh",
    "release": "commit-and-tag-version"
  },
  "commit-and-tag-version": {
    "scripts": {
      "precommit": "npm run format > /dev/null"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.987.0",
