{
  "name": "digitalhub-frontend",
  "version": "1.38.2",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel:build": "if [ -n \"$VERCEL_ENV\" ] && [ \"$VERCEL_ENV\" != \"production\" ]; then npm run vercel:seeded:build; else npm run vercel:prod:build; fi",
    "vercel:prod:build": "drizzle-kit migrate && next build",
    "vercel:seeded:build": "tsx scripts/db/reset.ts && drizzle-kit migrate && npm run db:seed && next build",
    "start": "next start",
    "format": "oxfmt",
    "stylecheck": "oxfmt --check && oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:ci": "playwright test",
    "test": "dotenv -c development -- playwright test",
    "test:ui": "dotenv -c development -- playwright test --ui",
    "test:unit": "dotenv -c development -- vitest",
    "next-auth:session": "dotenv -c development -- tsx scripts/auth/get-next-session.ts",
    "db:seed": "dotenv -c development -- tsx db/seed/seed.ts",
    "db:migrate": "dotenv -c development -- drizzle-kit migrate",
    "db:reset": "dotenv -c development -- sh -c \"tsx scripts/db/reset.ts && drizzle-kit migrate && tsx db/seed/seed.ts\"",
    "db:generate": "dotenv -c development -- drizzle-kit generate",
    "db:dump": "dotenv -c development -- ./scripts/db/dump-db.sh",
    "release": "commit-and-tag-version",
    "db:studio": "dotenv -c development -- drizzle-kit studio"
  },
  "commit-and-tag-version": {
    "scripts": {
      "precommit": "npm run format > /dev/null"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.987.0",
    "@aws-sdk/s3-request-presigner": "^3.987.0",
    "@hookform/resolvers": "^5.2.2",
    "@internationalized/date": "^3.10.1",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-select": "^2.1.3",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.1",
