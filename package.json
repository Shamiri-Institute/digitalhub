    "lucide-react": "^1.14.0",
    "next": "16.4.5",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-aria": "^3.48.0",
    "react-aria-components": "^1.10.1",
    "react-day-picker": "^9.8.0",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-stately": "^3.30.1",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.6.0",
    "typeid-js": "^1.2.0",
