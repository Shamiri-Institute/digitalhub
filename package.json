    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "commit-and-tag-version": "^12.5.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "0.31.10",
    "jsdom": "^29.1.1",
    "jsqr": "^1.4.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pdfjs-dist": "5.4.296",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react-is": "^19.0.0-rc-69d4b800-20241021"
  }
}
