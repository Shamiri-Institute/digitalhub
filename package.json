    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "0.45.2",
    "jsonwebtoken": "^9.0.0",
    "libphonenumber-js": "^1.12.33",
    "lucide-react": "^1.14.0",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "pdf-lib": "^1.17.1",
