    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "0.45.2",
    "ffmpeg-static": "^5.3.0",
