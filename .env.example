# Copy this file to .env.local and replace appropriate values with values from our credentials store

DATABASE_URL="postgres://youth:thriving@localhost:5432/shamiri_db?pool_timeout=30"

GOOGLE_ID=XXXXXXXXXX
GOOGLE_SECRET=XXXXXXXXXX

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=XXXXXXXXXX # Run `openssl rand -base64 32` to generate a secret (min 32 chars)
TEST_USER_PASSWORD=XXXXXXXXXX # Enables the email test login for seeded users (dev/test/training only)

S3_UPLOAD_KEY=XXXXXXXXXX # IAM access key used for all S3 buckets
S3_UPLOAD_SECRET=XXXXXXXXXX # IAM secret used for all S3 buckets
S3_UPLOAD_BUCKET=<your bucket>
S3_UPLOAD_REGION=<your region>

# S3 Recordings Bucket (dedicated bucket for session recordings)
S3_RECORDINGS_BUCKET=<your bucket>
S3_RECORDINGS_REGION=<your region>

# S3 Student Attendance Bucket (attendance documents)
S3_STUDENT_ATTENDANCE_BUCKET=<your bucket>
S3_STUDENT_ATTENDANCE_REGION=<your region> # defaults to af-south-1

# For Fidelity Ratings API
FIDELITY_API_URL=XXXX # Base URL of the Fidelity Ratings API service, no trailing slash
FIDELITY_API_KEY=XXXX # API key for authenticating requests to the fidelity API (X-API-Key header)

# application settings
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ENV=development # development | preview | production | testing | training
# Performance Profiler
# Set to "true" to enable the React DevProfiler overlay in development
# (Only active when NODE_ENV !== "production")
NEXT_PUBLIC_ENABLE_PERF_PROFILER=false

# --- Webhook Authentication ---
# API key that the Fidelity Ratings API includes in webhook requests TO SDH
# (x-api-key header). This is used by SDH to verify that incoming webhooks are
# legitimate. It's also used by the Fidelity Ratings API to check that the job
# request is legitimate (i.e. originated from SDH). Serves as a shared secret
# between both services
RECORDINGS_API_KEY=XXXXX

GOOGLE_CLIENT_ID=XXXXX
GOOGLE_CLIENT_EMAIL=XXXXX
GOOGLE_PROJECT_ID=XXXXX
GOOGLE_PRIVATE_KEY=XXXXX
PROGRESSNOTE_FILEID=XXXXX
TREATMENTPLAN_FILEID=XXXXX
CASEREPORTS_FILEID=XXXXX

# Metabase Configuration
METABASE_SECRET_KEY=XXXXXXXXXX # Secret key for signing Metabase JWT tokens
METABASE_MONITORING_DASHBOARD_ID=XXX # Dashboard ID for Monitoring and Evaluation embed

# --- Sentry (error monitoring) — entirely optional ---
# Leave these blank to run with Sentry disabled (the app builds and runs fine).
# To enable it, create a project at https://sentry.io and fill these in.

# Client-side DSN. Public by design. When set, errors are reported to your
# Sentry project AND the Content-Security-Policy automatically whitelists its
# ingest host. When blank, the Sentry SDK is a no-op everywhere.
NEXT_PUBLIC_SENTRY_DSN=

# Only needed to upload source maps at build time (for readable stack traces).
# SENTRY_AUTH_TOKEN should be set in CI / your host's env, NOT committed.
SENTRY_ORG=          # your Sentry org slug
SENTRY_PROJECT=      # your Sentry project slug
SENTRY_AUTH_TOKEN=   # build-time token; create at Sentry > Settings > Auth Tokens

